      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Sin token - rechazo Gateway",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/eventos",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\",()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar eventos autenticado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/eventos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear evento de demostracion",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/eventos",
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\": \"Demo S5 {{$timestamp}}\", \"fecha\": \"2026-12-15T18:00:00\", \"precio\": 10000}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"evento_id\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear compra",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/reservas",
        "body": {
          "mode": "raw",
          "raw": "{\"eventoId\": \"{{evento_id}}\", \"usuario\": \"demo-s5\", \"cantidad\": 2}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"reserva_id\",pm.response.json().id);",
              "pm.test(\"Total 20000\",()=>pm.expect(pm.response.json().total).to.eql(20000));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Estadisticas del evento",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/eventos/{{evento_id}}/estadisticas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Generar resumen PDF local",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/tickets/generar/{{reserva_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "const t=pm.response.json(); pm.collectionVariables.set(\"ticket_id\",t.id); pm.collectionVariables.set(\"numero_resumen\",t.numeroResumen);",
              "pm.test(\"Todavia sin S3\",()=>pm.expect(t.claveS3).to.be.null);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Descargar PDF antes de subir",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}/descargar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"PDF\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Subir resumen a S3",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}/subir"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const t=pm.response.json(); pm.collectionVariables.set(\"clave_s3\",t.claveS3);",
              "pm.test(\"Carpeta por numero de resumen\",()=>pm.expect(t.claveS3).to.match(new RegExp(\"^\"+t.numeroResumen+\"/\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Historial de resumenes",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tickets/historial?eventoId={{evento_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Modificar resumen subido",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\"detalle\": \"Resumen corregido en demostracion S5\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Misma clave S3\",()=>pm.expect(pm.response.json().claveS3).to.eql(pm.collectionVariables.get(\"clave_s3\")));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Descargar PDF desde S3",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}/descargar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"PDF\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/pdf\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Descargar ZIP del evento",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tickets/descargar?eventoId={{evento_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"ZIP\",()=>pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/zip\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Eliminar resumen de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\",()=>pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Confirmar eliminacion",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tickets/{{ticket_id}}/descargar"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\",()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    }
  ]
}
