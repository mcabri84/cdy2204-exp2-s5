      "type": "string"
    },
    {
      "key": "issuer",
      "value": "https://gestionguiasmcabri2026.b2clogin.com/tfp/3f3062b4-4f5c-4d4f-a8de-239dc8df83f7/b2c_1_eventos_signupsignin/v2.0/",
      "type": "string"
    },
    {
      "key": "base_url",
