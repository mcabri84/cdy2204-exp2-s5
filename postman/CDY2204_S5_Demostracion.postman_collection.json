{
  "info": {
    "_postman_id": "32f0954c-a235-47ee-97c6-7194b0bc5621",
    "name": "CDY2204 S5 Demostracion",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Demostracion individual S5: API Gateway, B2C, Spring Security y resumenes PDF/S3. Datos ficticios. Ejecutar en orden; elimina solo el resumen generado en esta corrida."
  },
